rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function getRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }
    // Cuenta habilitada: la administracion puede suspender a un usuario
    // problematico sin borrar su historial. Una cuenta suspendida puede leer
    // (para ver el aviso) pero no crear ni modificar nada.
    function activo() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('suspendido', false) != true;
    }
    function camposSuspension() {
      return ['suspendido', 'motivoSuspension', 'suspendidoPor', 'suspendidoEn'];
    }

    // Correos habilitados para darse de alta como administracion.
    // El codigo de admin del formulario es solo una comodidad de la interfaz:
    // el control real es esta lista, que se evalua en el servidor. Aunque
    // alguien lea el codigo en el fuente de la pagina, si su correo no esta
    // aca Firestore rechaza la creacion del perfil con rol 'admin'.
    function adminsHabilitados() {
      return [
        'tomasrecalde99@gmail.com'
        // Agregar aca los correos del resto del grupo, separados por coma.
      ];
    }

    // Perfil de cada usuario registrado (nombre, rol, entidad)
    match /usuarios/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.rol in ['mayorista', 'productor', 'admin', 'transportista']
                    && (request.resource.data.rol != 'admin'
                        || request.auth.token.email in adminsHabilitados());
      // El propio usuario edita sus datos, pero no puede cambiar su rol ni levantarse una suspension.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol // el rol no se puede cambiar despues de creado
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposSuspension())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificado'])
                    && fotoPerfilValida()
                    && activo();
      // La administracion marca o desmarca a un productor como verificado.
      allow update: if isSignedIn() && getRole() == 'admin' && activo()
                    && resource.data.rol == 'productor'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificado'])
                    && request.resource.data.verificado is bool;
      // La administracion suspende o reactiva cuentas de mayoristas y productores (nunca de otro admin
      // ni la propia), tocando solo los campos de la suspension.
      allow update: if isSignedIn() && getRole() == 'admin' && activo()
                    && request.auth.uid != uid
                    && resource.data.rol != 'admin'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposSuspension())
                    && request.resource.data.get('suspendido', false) is bool
                    && (!('motivoSuspension' in request.resource.data) || request.resource.data.motivoSuspension.size() <= 200);
      allow delete: if false;
    }

    // Foto o logo del perfil: es un data URL chico (se achica en el navegador a ~40 KB).
    function fotoPerfilValida() {
      return !('foto' in request.resource.data)
             || (request.resource.data.foto is string
                 && request.resource.data.foto.size() <= 70000
                 && request.resource.data.foto.matches('^data:image/.*'));
    }

    // Galeria de fotos de la finca (ficha publica del productor). Va aparte del
    // perfil para que la lista de contactos no descargue las fotos de todos.
    match /galerias/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && activo()
                   && getRole() == 'productor'
                   && request.resource.data.fotos is list
                   && request.resource.data.fotos.size() <= 4;
    }

    // Denuncias de publicaciones: las hace un mayorista y las revisa la administracion.
    match /denuncias/{id} {
      allow read: if isSignedIn() && (getRole() == 'admin' || resource.data.denuncianteUid == request.auth.uid);
      allow create: if isSignedIn() && getRole() == 'mayorista' && activo()
                    && request.resource.data.denuncianteUid == request.auth.uid
                    && request.resource.data.estado == 'abierta'
                    && request.resource.data.motivo is string
                    && request.resource.data.motivo.size() > 0
                    && request.resource.data.motivo.size() <= 300;
      allow update: if isSignedIn() && getRole() == 'admin' && activo()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revisadaPor', 'revisadaEn'])
                    && request.resource.data.estado in ['resuelta', 'descartada'];
      allow delete: if false;
    }

    // Licitaciones: el mayorista publica lo que necesita y elige la mejor oferta.
    match /licitaciones/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() == 'mayorista' && activo()
                    && request.resource.data.mayoristaUid == request.auth.uid
                    && request.resource.data.estado == 'abierta';
      allow update: if isSignedIn() && activo() && resource.data.mayoristaUid == request.auth.uid
                    && request.resource.data.mayoristaUid == resource.data.mayoristaUid;
      allow delete: if false;
    }
    // Ofertas a una licitacion: cada productor ve las suyas y el mayorista las que recibio.
    match /ofertasLicit/{id} {
      function licit(lid) { return get(/databases/$(database)/documents/licitaciones/$(lid)).data; }
      allow read: if isSignedIn() && (resource.data.productorUid == request.auth.uid
                    || resource.data.mayoristaUid == request.auth.uid || getRole() == 'admin');
      allow create: if isSignedIn() && getRole() == 'productor' && activo()
                    && request.resource.data.productorUid == request.auth.uid
                    && licit(request.resource.data.licitacionId).estado == 'abierta'
                    && licit(request.resource.data.licitacionId).cierre > request.time.toMillis()
                    && licit(request.resource.data.licitacionId).mayoristaUid == request.resource.data.mayoristaUid
                    && request.resource.data.precio is number && request.resource.data.precio > 0;
      allow update: if isSignedIn() && activo() && (
                      (resource.data.productorUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['precio', 'cantidad', 'comentario', 'actualizado', 'vistaGanadora'])
                        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistaGanadora'])
                            || (licit(resource.data.licitacionId).estado == 'abierta' && licit(resource.data.licitacionId).cierre > request.time.toMillis())))
                      || (resource.data.mayoristaUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])));
      allow delete: if false;
    }
    // Trazabilidad publica: la lee cualquiera que escanee la caja (sin cuenta).
    // Solo escriben el productor o el transportista del pedido.
    match /trazas/{orderId} {
      allow read: if true;
      allow write: if isSignedIn() && activo()
                   && (get(/databases/$(database)/documents/pedidos/$(orderId)).data.productorUid == request.auth.uid
                       || get(/databases/$(database)/documents/pedidos/$(orderId)).data.get('transportistaUid', '') == request.auth.uid);
    }

    // Productos publicados por productores.
    // El dueño del lote y la administracion pueden editarlo libremente.
    // Ademas, un mayorista puede descontar stock al confirmarse un pedido:
    // solo se le permite bajar el stock, nunca subirlo ni tocar otros campos.
    match /lotes/{lotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() == 'productor' && activo()
                    && request.resource.data.productorUid == request.auth.uid;
      allow update: if isSignedIn() && activo() &&
                    (resource.data.productorUid == request.auth.uid
                     || getRole() == 'admin'
                     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                         && request.resource.data.stock >= 0
                         && request.resource.data.stock < resource.data.stock));
      allow delete: if false;
    }

    // Pedidos mayoristas
    // El mayorista solo puede cancelar un pedido suyo u ocultarlo de su lista:
    // no puede tocar el estado, asi no puede marcarlo como entregado para
    // calificar sin haber comprado.
    match /pedidos/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() == 'mayorista' && activo()
                    && request.resource.data.mayoristaUid == request.auth.uid;
      allow update: if isSignedIn() && activo() &&
                    (getRole() == 'admin' ||
                     (getRole() == 'productor' && resource.data.productorUid == request.auth.uid) ||
                     (getRole() == 'mayorista' && resource.data.mayoristaUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelado', 'ocultoMayorista'])) ||
                     // El transportista toma un viaje libre (pedido confirmado o en preparacion)...
                     (getRole() == 'transportista' && resource.data.get('transportistaUid', null) == null
                      && resource.data.get('cancelado', false) != true
                      && resource.data.statusIdx >= 1 && resource.data.statusIdx <= 2
                      && request.resource.data.transportistaUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transportistaUid', 'transportistaNombre', 'transportistaTel', 'tomadoEn'])) ||
                     // ...y despues avanza el envio de a un paso, desde el despacho en adelante.
                     (getRole() == 'transportista' && resource.data.get('transportistaUid', null) == request.auth.uid
                      && request.resource.data.traceIdx == resource.data.traceIdx + 1
                      && request.resource.data.traceIdx >= 2
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['traceIdx', 'statusIdx', 'invoice'])));
      allow delete: if false;
    }

    // Mensajes de cada pedido entre el comprador y el productor.
    // Solo los ven y los escriben las dos partes del pedido (la administracion
    // puede leerlos). Los mensajes no se editan ni se borran.
    match /pedidos/{orderId}/mensajes/{msgId} {
      function esParte() {
        let p = get(/databases/$(database)/documents/pedidos/$(orderId)).data;
        return p.mayoristaUid == request.auth.uid || p.productorUid == request.auth.uid;
      }
      allow read: if isSignedIn() && (esParte() || getRole() == 'admin');
      allow create: if isSignedIn() && esParte() && activo()
                    && request.resource.data.autorUid == request.auth.uid
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 500;
      allow update, delete: if false;
    }

    // Chats directos entre un mayorista y un productor, sin pedido de por medio.
    // Hay una conversacion por par y su id es "mayoristaUid_productorUid", asi
    // que nadie puede abrir una a nombre de otros. Las reglas verifican el rol
    // real de cada parte contra su perfil. Solo las dos partes la leen y la
    // escriben (la administracion puede leer). Los mensajes no se editan ni se borran.
    match /conversaciones/{convId} {
      function partes() {
        return [request.resource.data.mayoristaUid, request.resource.data.productorUid];
      }
      allow read: if isSignedIn() &&
                  (request.auth.uid in resource.data.participantes || getRole() == 'admin');
      allow create: if isSignedIn() && activo()
                    && convId == request.resource.data.mayoristaUid + '_' + request.resource.data.productorUid
                    && request.resource.data.participantes == partes()
                    && request.auth.uid in partes()
                    && get(/databases/$(database)/documents/usuarios/$(request.resource.data.mayoristaUid)).data.rol == 'mayorista'
                    && get(/databases/$(database)/documents/usuarios/$(request.resource.data.productorUid)).data.rol == 'productor'
                    && request.resource.data.ultimoAutorUid == request.auth.uid;
      // Despues de creada solo cambia el resumen del ultimo mensaje y las marcas
      // de leido; las partes y los nombres quedan fijos.
      allow update: if isSignedIn() && activo() && request.auth.uid in resource.data.participantes
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['ultimoMensaje', 'ultimoAutorUid', 'actualizado', 'vistoMayorista', 'vistoProductor', 'escribiendoMayorista', 'escribiendoProductor'])
                    && (request.resource.data.ultimoAutorUid == resource.data.ultimoAutorUid
                        || request.resource.data.ultimoAutorUid == request.auth.uid);
      allow delete: if false;

      match /mensajes/{msgId} {
        // El id de la conversacion contiene los uid de las dos partes.
        allow read: if isSignedIn() &&
                    (request.auth.uid in convId.split('_') || getRole() == 'admin');
        // getAfter: la conversacion puede crearse en el mismo lote que su primer mensaje.
        allow create: if isSignedIn() && activo()
                      && request.auth.uid in getAfter(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 500
                      // Adjunto opcional: foto o PDF chico guardado dentro del mensaje.
                      && (!('adjunto' in request.resource.data)
                          || (request.resource.data.adjunto.data is string
                              && request.resource.data.adjunto.data.size() <= 750000
                              && request.resource.data.adjunto.tipo in ['imagen', 'pdf']));
        // Cada parte puede poner o sacar su reaccion con emoji.
        allow update: if isSignedIn() && activo()
                      && request.auth.uid in convId.split('_')
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacciones']);
        allow delete: if false;
      }
    }

    // Cotizaciones y reservas de cosecha entre un mayorista y un productor.
    // El mayorista la pide; el productor responde con un precio o la rechaza;
    // el mayorista la acepta (y genera el pedido), la rechaza o propone otro
    // precio (contraoferta). El productor acepta la contraoferta, propone otro
    // precio o la rechaza, y asi hasta cerrar. Cada parte solo puede hacer los
    // cambios de estado que le corresponden; las propuestas tienen un tope.
    match /cotizaciones/{cotId} {
      function esParteCot() {
        return request.auth.uid in resource.data.participantes;
      }
      function soloCambia(campos) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
      }
      function rondasOk() {
        return !('rondas' in request.resource.data)
            || (request.resource.data.rondas is list && request.resource.data.rondas.size() <= 10);
      }
      allow read: if isSignedIn() && (esParteCot() || getRole() == 'admin');
      allow create: if isSignedIn() && getRole() == 'mayorista' && activo()
                    && request.resource.data.mayoristaUid == request.auth.uid
                    && request.resource.data.participantes == [request.auth.uid, request.resource.data.productorUid]
                    && request.resource.data.convId == request.auth.uid + '_' + request.resource.data.productorUid
                    && get(/databases/$(database)/documents/usuarios/$(request.resource.data.productorUid)).data.rol == 'productor'
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.qty is number && request.resource.data.qty > 0
                    && request.resource.data.producto is string && request.resource.data.producto.size() <= 80
                    && request.resource.data.origen in ['chat', 'cosecha']
                    && !('precioOfertado' in request.resource.data);
      allow update: if isSignedIn() && activo() && rondasOk() && (
        // Productor: a una cotizacion pendiente o a una contraoferta le responde
        // con un precio (o acepta el del mayorista), o la rechaza.
        (request.auth.uid == resource.data.productorUid && resource.data.estado in ['pendiente', 'contraoferta']
          && ((request.resource.data.estado == 'cotizada' && request.resource.data.precioOfertado is number
               && request.resource.data.precioOfertado > 0
               && soloCambia(['estado', 'precioOfertado', 'acordado', 'rondas', 'actualizado']))
              || (request.resource.data.estado == 'rechazada' && soloCambia(['estado', 'actualizado']))))
        ||
        // Mayorista: cancela la que pidió (o retira su contraoferta), acepta / rechaza
        // el precio recibido, o propone otro precio.
        (request.auth.uid == resource.data.mayoristaUid
          && ((resource.data.estado in ['pendiente', 'contraoferta'] && request.resource.data.estado == 'cancelada' && soloCambia(['estado', 'actualizado']))
              || (resource.data.estado == 'cotizada' && request.resource.data.estado in ['aceptada', 'rechazada']
                  && soloCambia(['estado', 'actualizado', 'pedidoId', 'numeroPedido']))
              || (resource.data.estado == 'cotizada' && request.resource.data.estado == 'contraoferta'
                  && request.resource.data.precioContraoferta is number && request.resource.data.precioContraoferta > 0
                  && soloCambia(['estado', 'precioContraoferta', 'acordado', 'rondas', 'actualizado']))))
      );
      allow delete: if false;
    }

    // Pedidos programados: el mayorista programa un pedido que se repite cada
    // 7, 14 o 30 dias. Solo el dueño los ve y los cambia; el pedido real lo
    // genera el sistema del mayorista y pasa por las reglas de /pedidos.
    match /programados/{progId} {
      function datosOk() {
        let d = request.resource.data;
        return d.mayoristaUid == request.auth.uid
          && d.qty is number && d.qty > 0
          && d.frecuencia in [7, 14, 30]
          && d.proxima is number
          && d.activo is bool;
      }
      allow read: if isSignedIn() && (resource.data.mayoristaUid == request.auth.uid || getRole() == 'admin');
      allow create: if isSignedIn() && getRole() == 'mayorista' && activo() && datosOk();
      allow update: if isSignedIn() && activo() && resource.data.mayoristaUid == request.auth.uid && datosOk();
      allow delete: if isSignedIn() && resource.data.mayoristaUid == request.auth.uid;
    }

    // Calendario de cosecha: cada productor anuncia sus cosechas futuras.
    match /cosechas/{cosechaId} {
      function cosechaValida() {
        let d = request.resource.data;
        return d.productorUid == request.auth.uid
            && d.producto is string && d.producto.size() >= 3 && d.producto.size() <= 60
            && d.desde is int && d.desde >= 0 && d.desde <= 11
            && d.hasta is int && d.hasta >= 0 && d.hasta <= 11
            && d.volumen is number && d.volumen > 0
            && d.unit in ['kg', 'L']
            && d.notas is string && d.notas.size() <= 200;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() == 'productor' && activo() && cosechaValida();
      allow update: if isSignedIn() && resource.data.productorUid == request.auth.uid && activo() && cosechaValida();
      allow delete: if isSignedIn() && activo() && (resource.data.productorUid == request.auth.uid || getRole() == 'admin');
    }

    // Bitacora de actividad (auditoria). Cualquier usuario registra sus propias
    // acciones, con su rol real y la hora del servidor; solo la administracion
    // la lee y nadie puede editar ni borrar un registro.
    match /bitacora/{logId} {
      allow read: if isSignedIn() && getRole() == 'admin';
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rol == getRole()
                    && request.resource.data.accion is string && request.resource.data.accion.size() <= 60
                    && request.resource.data.detalle is string && request.resource.data.detalle.size() <= 300
                    && request.resource.data.fecha == request.time;
      allow update, delete: if false;
    }

    // Calificaciones de 1 a 5 estrellas (ranking de proveedores).
    // Una por pedido: el id del documento es el id del pedido. Solo la puede
    // escribir el mayorista que hizo el pedido, y solo si ya fue entregado.
    function pedidoCalificable(pedidoId) {
      let p = get(/databases/$(database)/documents/pedidos/$(pedidoId)).data;
      return p.mayoristaUid == request.auth.uid
          && p.statusIdx == 4
          && p.productorUid == request.resource.data.productorUid;
    }
    function calificacionValida(pedidoId) {
      let d = request.resource.data;
      return d.pedidoId == pedidoId
          && d.mayoristaUid == request.auth.uid
          && d.estrellas is int && d.estrellas >= 1 && d.estrellas <= 5
          && d.comentario is string && d.comentario.size() <= 300;
    }
    match /calificaciones/{pedidoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() == 'mayorista' && activo()
                    && calificacionValida(pedidoId) && pedidoCalificable(pedidoId);
      allow update: if isSignedIn() && getRole() == 'mayorista' && activo()
                    && resource.data.mayoristaUid == request.auth.uid
                    && calificacionValida(pedidoId) && pedidoCalificable(pedidoId);
      allow delete: if false;
    }

    // Proyectos de software a medida.
    // La administracion gestiona todos; un productor puede crear su propia
    // solicitud y seguir su avance, pero no modificar la etapa ni ver las ajenas.
    match /proyectos/{projId} {
      allow read: if isSignedIn() &&
                  (getRole() == 'admin' || resource.data.solicitanteUid == request.auth.uid);
      allow create: if isSignedIn() && activo() &&
                    (getRole() == 'admin' ||
                     (getRole() == 'productor'
                      && request.resource.data.solicitanteUid == request.auth.uid
                      && request.resource.data.stageIdx == 0));
      allow update: if isSignedIn() && getRole() == 'admin';
      allow delete: if false;
    }

    // Contador para numerar pedidos (CC-8841, CC-8842, ...)
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && activo() && (getRole() == 'mayorista' || getRole() == 'admin');
    }
  }
}
